module rbq_msgs {
  module msg {
    module dds_ {
      @extensibility(FINAL)
      struct JointInfo_ {
        float pos;              // rad
        float vel;              // rad/s
        float acc;              // rad/s^2
        float torque;           // N·m
        float kp;               // Nm/rad
        float kd;               // Nm*s/rad
        int8  owner;            // 0~40
        float ref_ff_torque;    // N·m
        float ref_position;     // rad
        float ref_vel;          // rad/s
        float current;          // Amperes
        int8  temperature_board;// Celcius
        int8  temperature_coil; // Celcius
        string<3> name;         // 3-letter joint name e.g. "HRR"
        string<3> status;       // 3-letter lifecycle: NON/CON/HOM/RUN
        string<3> error_msg;    // 3-letter error code e.g. "JAM", "OK"
      };
    };
  };
};

Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /LiDAR rear1/Topic1
        - /LiDAR ouster1/Topic1
        - /front RGB1/Topic1
        - /rear RGB1/Topic1
      Splitter Ratio: 0.5
    Tree Height: 452
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.10000000000000001</near>
              <far>5</far>
            </clip>
          </camera>
          <pose>0.26053 0 -0.04759 -1.5708 1.32645 -3.14159</pose>
        </sensor>
  <sensor name="BT1_color" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>

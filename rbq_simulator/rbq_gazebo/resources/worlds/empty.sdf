        <collision name="c"><geometry><box><size>1.68 3.0 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.68 3.0 0.05</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>

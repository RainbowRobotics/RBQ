        <pose>6.898 -7 0.05 0 0.5236 0</pose>
        <collision name="c"><geometry><box><size>3.0 3.0 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 3.0 0.05</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Slippery Terrain (low friction)                              -->
    <!-- ============================================================ -->
    <model name="slippery_terrain">
      <static>true</static>
      <link name="slip1">
        <pose>3 3 0.05 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>5.0 1.6 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.2</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>5.0 1.6 0.1</size></box></geometry>
          <material><ambient>0.7 0.4 0.9 0.7</ambient><diffuse>0.7 0.4 0.9 0.7</diffuse></material></visual>
      </link>
      <link name="slip2">
        <pose>3 5 0.05 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>5.0 1.6 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.1</mu><mu2>0.1</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>5.0 1.6 0.1</size></box></geometry>
          <material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.5 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Docking Station (OBJ mesh + ArUco markers)                   -->
    <!-- ============================================================ -->
    <model name="docking_station">
      <static>true</static>
      <pose>-1.5 -6 0.005 3.14159 0 0</pose>
      <link name="body">
        <visual name="mesh_visual">
          <geometry>
            <mesh>
              <uri>model://env/Docking_station.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="mesh_collision">
          <geometry>
            <mesh>
              <uri>model://env/Docking_station.obj</uri>
            </mesh>
          </geometry>
        </collision>
      </link>
      <link name="bottom_aruco">
        <pose>-0.1 -0.08 -0.035 -3.14159 0 1.5708</pose>
        <visual name="v">
          <geometry><box><size>0.1 0.1 0.002</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://env/bottom_id.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.5</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
      <link name="rear_aruco">
        <pose>-0.4 -0.08 -0.50 -1.5708 1.5708 0</pose>
        <visual name="v">
          <geometry><box><size>0.1 0.1 0.002</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://env/rear_id.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.5</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>


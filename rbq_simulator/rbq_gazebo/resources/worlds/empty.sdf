    </model>

    <!-- ============================================================ -->
    <!-- 20° Slope Set 1 (y=-3.5): up — flat — down                  -->
    <!-- ============================================================ -->
    <model name="slope20_set1">
      <static>true</static>
      <link name="up">
        <pose>3.3 -3.5 0.05 0 -0.3491 0</pose>
        <collision name="c"><geometry><box><size>3.0 3.0 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 3.0 0.05</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
      <link name="flat">

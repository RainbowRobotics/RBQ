                <joint name="joint9_FLR" class="left_abduction"/>
                <geom type="mesh" mesh="hip3" material="hip_material" euler="0 0 0" class="visual"/>

                <body name="FL_thigh" pos="0 0.10285 0">
                    <inertial pos="-0.004765 0.00441 -0.06311" mass="1.80014"

<?xml version="1.0" encoding="utf-8"?>
<mujoco model="rbq">
    <compiler
        angle="radian"
        coordinate="local"
        autolimits="true"
    />

    <option
        timestep="0.001"
        gravity="0 0 -9.81"
        integrator="RK4"
        cone="elliptic"
        impratio="100"
        tolerance="1e-10" >
        <flag warmstart="enable" energy="enable" contact="enable" frictionloss="enable"/>
    </option>

    <default>
        <default class="rbq">
            <geom friction="0.0" margin="0.001" condim="1"/>

            <default class="abduction">
                <default class="left_abduction">
                    <joint axis="1 0 0" range="-0.5411 0.7330" damping="0." armature="0.014058265" frictionloss="0.5"/>
                    <motor ctrlrange="-100 100" ctrllimited="true"/>
                </default>
                <default class="right_abduction">
                    <joint axis="1 0 0" range="-0.7330 0.5411" damping="0." armature="0.014058265" frictionloss="0.5"/>
                    <motor ctrlrange="-100 100" ctrllimited="true"/>
                </default>
            </default>
            <default class="hip">
                <joint axis="0 1 0" range="-6.2832 6.2832" damping="0." armature="0.014058265" frictionloss="0.5"/>
                <motor ctrlrange="-100. 100" ctrllimited="true"/>
            </default>
            <default class="knee">
                <joint axis="0 1 0" range="-2.8274 -0.4189" damping="0." armature="0.0214816" frictionloss="0.5"/>
                <motor ctrlrange="-150. 150" ctrllimited="true"/>
            </default>
            <default class="visual">
                <geom type="mesh" contype="0" conaffinity="0" group="2"/>
            </default>
            <default class="collision">
                <geom contype="1" conaffinity="1" group="3"/>
                <default class="foot">
                    <geom type="sphere" size="0.03" priority="1" condim="6"
                        friction="0.8 0.8 0.8"/>
                </default>
            </default>
        </default>
    </default>

    <asset>
        <material name="metal" rgba=".9 .95 .95 1"/>
        <material name="black" rgba="0 0 0 1"/>
        <material name="white" rgba="1 1 1 1"/>
        <material name="gray" rgba="0.671705 0.692426 0.774270 1"/>
        <material name="graygray" rgba="0.4 0.4 0.4 1"/>
        <material name="tan" rgba="0.823 0.706 0.549 1"/>
        <material name="palegoldenrod" rgba="0.9334 0.91 0.667 1.0"/>
        <material name="charcoal" rgba="0.3 0.3 0.3 1.0"/>
        <material name="darker_gray" rgba="0.2 0.2 0.2 1.0"/>

        <material name="trunk_material" texture="trunk_texture"/>
        <texture name="trunk_texture" type="2d" file="../meshes/rbq/trunk_skin.png" />
        <material name="hip_material" texture="hip_texture"/>
        <texture name="hip_texture" type="2d" file="../meshes/rbq/hip_skin.png" />
        <material name="thigh_left_material" texture="thigh_left_texture"/>
        <texture name="thigh_left_texture" type="2d" file="../meshes/rbq/thigh_left_skin.png" />
        <material name="thigh_right_material" texture="thigh_right_texture"/>
        <texture name="thigh_right_texture" type="2d" file="../meshes/rbq/thigh_right_skin.png" />
        <material name="calf_material" texture="calf_texture"/>
        <texture name="calf_texture" type="2d" file="../meshes/rbq/calf_skin.png" />

        <mesh name="trunk" file="../meshes/rbq/trunk.obj" scale="1 1 1"/>
        <mesh name="trunk_collision" file="../meshes/rbq/trunk_collision.obj" scale="1 1 1"/>
        <mesh name="hip2" file="../meshes/rbq/hip2.obj" scale="1 1 1"/>
        <mesh name="hip3" file="../meshes/rbq/hip3.obj" scale="1 1 1"/>
        <mesh name="thigh" file="../meshes/rbq/thigh.obj" scale="1 1 1"/>
        <mesh name="calf" file="../meshes/rbq/calf.obj" scale="1 1 1"/>

        <!-- LiDAR housings, split into body + optical window so each carries its own colour.
             The palette below is shared with the rbq_gazebo URDFs; keep the two in step. -->
        <material name="mid360_body_mat"   rgba="0.765 0.788 0.800 1"/>   <!-- anodised aluminium -->
        <material name="mid360_dome_mat"   rgba="0.043 0.451 0.537 1"/>   <!-- optical dome, teal -->
        <material name="ouster_body_mat"   rgba="0.682 0.690 0.722 1"/>   <!-- anodised aluminium -->
        <material name="ouster_window_mat" rgba="0.039 0.039 0.047 1"/>   <!-- optical band, gloss black -->
        <mesh name="mid360_body"   file="../meshes/sensor/mid360_body.stl" scale="0.001 0.001 0.001"/>
        <mesh name="mid360_dome"   file="../meshes/sensor/mid360_dome.stl" scale="0.001 0.001 0.001"/>
        <mesh name="ouster_body"   file="../meshes/sensor/ouster_body.stl"/>
        <mesh name="ouster_window" file="../meshes/sensor/ouster_window.stl"/>
    </asset>

    <worldbody>
        <body name="base_link" pos="0 0 0.7" quat="1 0 0 0" childclass="rbq">
            <inertial
                pos="-0.013265 0.0 0.011765"
                mass="16.758"
                fullinertia="0.163831629266 0.590891341306 0.678714788268 -0.000271071491 0.040352639311 0.000216428332"/>
            <freejoint/>
            <geom type="mesh" mesh="trunk" material="trunk_material" class="visual"/>
            <geom type="mesh" mesh="trunk_collision" material="graygray" class="collision"/>

            <camera name="track_cam" mode="track" target="base_link" pos="0 -2 1" euler="20 0 0"/>

            <site name="imu" pos="0.00665 0 -0.0404"/>

            <!-- Livox Mid360 x2 (front/rear) + Ouster OS1 x1 (rear deck).
                 site = sensor frame (raytrace origin); geom = housing mesh (visual only).
                 Extrinsics match rbq_gazebo livox.urdf / ouster.urdf.
                 Housings sit in group 4 (Livox) / 5 (Ouster) so each build can be shown alone;
                 raycasts use the sites and are unaffected by visibility. -->
            <site name="lidar_front" pos="0.372824 0 0.127636" quat="0.953716987 0 0.300705686 0"/>
            <geom type="mesh" mesh="mid360_body" material="mid360_body_mat" class="visual" group="4"
                  pos="0.372824 0 0.127636" quat="0.212631537 -0.212630522 -0.67438095 -0.674378547"/>
            <geom type="mesh" mesh="mid360_dome" material="mid360_dome_mat" class="visual" group="4"
                  pos="0.372824 0 0.127636" quat="0.212631537 -0.212630522 -0.67438095 -0.674378547"/>
            <site name="lidar_rear" pos="-0.333 0 0.20763" quat="0.953716987 0 -0.300705686 0"/>
            <geom type="mesh" mesh="mid360_body" material="mid360_body_mat" class="visual" group="4"
                  pos="-0.333 0 0.20763" quat="0.67437851 0.674380987 -0.212630639 0.21263142"/>
            <geom type="mesh" mesh="mid360_dome" material="mid360_dome_mat" class="visual" group="4"
                  pos="-0.333 0 0.20763" quat="0.67437851 0.674380987 -0.212630639 0.21263142"/>
            <site name="lidar_ouster" pos="-0.3125 0 0.105" quat="0 0 0 1"/>
            <geom type="mesh" mesh="ouster_body" material="ouster_body_mat" class="visual" group="5"
                  pos="-0.3125 0 0.105" quat="0 0 0 1"/>
            <geom type="mesh" mesh="ouster_window" material="ouster_window_mat" class="visual" group="5"
                  pos="-0.3125 0 0.105" quat="0 0 0 1"/>

            <body name="BT0_body" pos="0.364 0 -0.024919" quat="0 -0.1736482 0 0.9848078">
                <camera name="BT0"
                    mode="fixed"
                    pos="0 0 0"
                    quat="1 0 0 0"
                    focal="1.93e-3 1.93e-3"
                    resolution="640 360"
                    sensorsize="3896e-6 2140e-6"/>
            </body>
            <body name="BT1_body" pos="0.26097 0 -0.04582" quat="0 0.1218693 0 0.9925462">
                <camera name="BT1"
                    mode="fixed"
                    pos="0 0 0"
                    quat="1 0 0 0"
                    focal="1.93e-3 1.93e-3"
                    resolution="640 360"
                    sensorsize="3896e-6 2140e-6"/>
            </body>
            <body name="BT2_body" pos="-0.19515 0.0065 -0.0465" quat="0 0 0 1">
                <camera name="BT2"
                    mode="fixed"
                    pos="0 0 0"
                    quat="1 0 0 0"
                    focal="1.93e-3 1.93e-3"
                    resolution="640 360"
                    sensorsize="3896e-6 2140e-6"/>
            </body>
            <body name="BT3_body" pos="-0.352082 -0.000011 -0.018938" quat="0.9848078 0 0.1736482 0">
                <camera name="BT3"
                    mode="fixed"
                    pos="0 0 0"
                    quat="1 0 0 0"
                    focal="1.93e-3 1.93e-3"
                    resolution="640 360"
                    sensorsize="3896e-6 2140e-6"/>
            </body>
            <body name="FT0_body" pos="0.388031 -0.037500 0.037764" quat="0.5 0.5 -0.5 -0.5">
                <camera name="FT0"
                    mode="fixed"
                    pos="0 0 0"
                    quat="1 0 0 0"
                    focal="1.93e-3 1.93e-3"
                    resolution="640 360"
                    sensorsize="384e-5 240e-5"/>
            </body>
            <body name="RR0_body" pos="-0.388031 0.037500 0.037764" quat="-0.5 -0.5 -0.5 -0.5">
                <camera name="RR0"
                    mode="fixed"
                    pos="0 0 0"
                    quat="1 0 0 0"
                    focal="1.93e-3 1.93e-3"
                    resolution="640 360"
                    sensorsize="384e-5 240e-5"/>
            </body>

            <!-- RR leg -->
            <body name="RR_hip" pos="-0.31218 -0.09 0." euler="0 0 0">
                <inertial pos="0.027522 -0.01681 -0.00187" mass="3.669344"
                    fullinertia="0.006957590282 0.00993982268 0.012145140245 -0.0017011378 -0.000029676183 0.000087952172"/>

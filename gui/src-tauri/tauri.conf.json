{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RBQ",
  "version": "0.1.0",
  "identifier": "com.rainbowrobotics.rbq",
  "build": {
    "beforeBuildCommand": "npm run web:export && npm run proxy:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RBQ",
        "url": "about:blank",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "externalBin": ["binaries/rbq-proxy"],
    "resources": { "../dist": "dist" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

# Every value here is optional. Copy this file to `.env` and fill what you need; EXPO_PUBLIC_* values are
# inlined at build time, so rebuild after changing them. An empty value hides the feature that needs it.

# Developer-mode code (level 2 unlocks developer screens) as a SHA-256 hash, not plain text.
# Generate: echo -n '<code>' | sha256sum. Unset = developer mode can't be turned on (there is no default code).
# This is a UI lock, not a security boundary: the hash ships inside the app.
EXPO_PUBLIC_LV2_SHA256=

# Default robot API password. Empty = the app asks once per robot.
EXPO_PUBLIC_ROBOT_DEFAULT_AUTH=
# Robot firmware transfer token. Empty = firmware transfer UI hidden.
EXPO_PUBLIC_ROBOT_OTA_TOKEN=
# Platform server (remote connection, accounts, push, log upload). Empty = those features hidden.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_LOG_BUCKET=
# In-app issue report server, and the GitHub repo opened by "GitHub issue". Empty = hidden.
EXPO_PUBLIC_REVIEW_URL=
EXPO_PUBLIC_ISSUES_REPO=
# Where firmware/app update files are downloaded from (https://host). Update checks only run in builds with a
# release channel (RBQ_CHANNEL / RBQ_NIGHTLY below); leave both unset for a build without update checks.
EXPO_PUBLIC_DOWNLOAD_BASE=

# Build-time variables (shell environment, not this file):
#   RBQ_VERSION   version string (default: git describe)
#   RBQ_CHANNEL   release | nightly — enables update checks against EXPO_PUBLIC_DOWNLOAD_BASE
#   RBQ_NIGHTLY=1 nightly package id / icon
# Desktop proxy (tools/rbq-web-proxy.js) options are its command-line flags: --robot, --port, --host, --dist.

 #import "WebRTCModule.h"
 
+@interface RBQMonotonicRenderer : NSObject<RTCVideoRenderer>
+- (instancetype)initWithTarget:(id<RTCVideoRenderer>)target;
+@end
+
+@implementation RBQMonotonicRenderer {
+    id<RTCVideoRenderer> _target;
+    int64_t _lastNs;
+}
+- (instancetype)initWithTarget:(id<RTCVideoRenderer>)target {
+    if (self = [super init]) {
+        _target = target;
+        _lastNs = INT64_MIN;
+    }
+    return self;
+}
+- (void)setSize:(CGSize)size {
+    [_target setSize:size];
+}
+- (void)renderFrame:(nullable RTCVideoFrame *)frame {
+    if (frame && frame.timeStampNs <= _lastNs) {
+        RTCVideoFrame *f = [[RTCVideoFrame alloc] initWithBuffer:frame.buffer
+                                                        rotation:frame.rotation
+                                                     timeStampNs:_lastNs + 1];
+        f.timeStamp = frame.timeStamp;
+        frame = f;
+    }
+    if (frame) _lastNs = frame.timeStampNs;
+    [_target renderFrame:frame];
+}
+@end
+

<?xml version="1.0" encoding="utf-8"?>
<mujoco model="environment_arm_with_door">
    <compiler
        angle="radian"
        coordinate="local"
        meshdir="../../../meshes/"
        texturedir="../../../meshes/"
        autolimits="true"
    />


    <!-- 로봇 모델 -->
    <include file="../../rbq10_with_rb1.xml"/>

    <!-- 통계 정보 -->
    <statistic center="0 0 0.1" extent="0.8"/>

    <!-- 시각화 설정 -->
    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="-130" elevation="-20"/>
    </visual>

    <!-- 에셋 정의 -->
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
                 markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

        <!-- door_knob assets -->
        <material name="Paint" shininess="0.39" specular="0.26" texture="wall_geom"/>
        <material name="Wood" shininess="0.18" specular="0.17" texture="frame_geom"/>
        <material name="Carpet" shininess="0.03" specular="0.01" texture="door_geom"/>
        <material name="Metal" rgba="0.95 0.95 1.0 1.0" shininess="1.0" specular="1.0" texture="knob_geom"/>
        <material name="Floor" texture="texplane"/>

        <mesh file="env/door/lever/body_1.stl" name="door_knob_1" scale="0.002 0.002 0.002"/>
        <mesh file="env/door/lever/body_2.stl" name="door_knob_2" scale="0.002 0.002 0.002"/>
        <mesh file="env/door/lever/body_3.stl" name="door_knob_3" scale="0.002 0.002 0.002"/>
        <mesh file="env/door/lever/body_4.stl" name="door_knob_4" scale="0.002 0.002 0.002"/>
        <mesh file="env/door/lever/body_5.stl" name="door_knob_5" scale="0.002 0.002 0.002"/>

        <texture builtin="flat" height="32" name="wall_geom" type="2d" width="32"/>
        <texture builtin="flat" height="32" name="frame_geom" type="2d" width="32"/>
        <texture builtin="flat" height="32" name="door_geom" type="2d" width="32"/>
        <texture builtin="flat" height="32" name="knob_geom" type="2d" width="32"/>
        <texture builtin="gradient" height="128" rgb1="0.4 0.6 0.8" rgb2="0 0 0" type="skybox" width="128"/>
        <texture builtin="checker" height="512" name="texplane" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2" type="2d" width="512"/>
        <texture name="aruco_tex" file="base/5x5_1000.png" type="2d"/>
        <material name="round_valve_mat" rgba="0.95 0.95 1.0 1.0" shininess="1.0" specular="1.0"/>
        <material name="aruco_material" texture="aruco_tex" rgba="1 1 1 1"/>
    </asset>

    <!-- default 설정 -->
    <default>
        <joint armature="1" damping="1" limited="true"/>
        <default class="wall"><geom rgba="0.01 0.05 0.08 1.0" type="mesh"/></default>
        <default class="frame"><geom rgba="0.83 0.74 0.8 1.0" type="mesh"/></default>
        <default class="door"><geom rgba="0.91 0.57 0.44 1.0" type="mesh"/></default>
        <default class="door_knob"><geom condim="4" type="mesh"/></default>
        <default class="robot"><joint damping="0.1"/></default>
    </default>

    <!-- 접촉 정의 -->
    <contact>
        <pair geom1="doorstopper" geom2="door0" solref="0.01 1"/>
        <!-- High friction between gripper and lever handle -->
        <!-- friction="sliding friction, torsional friction, rolling friction" -->
        <pair geom1="knob_bar" geom2="RB1_finger_upper_collision" friction="3.0 0.5 0.01" solref="0.01 1"/>
        <pair geom1="knob_bar" geom2="RB1_finger_lower_collision" friction="3.0 0.5 0.01" solref="0.01 1"/>
        <pair geom1="knob_axis" geom2="RB1_finger_upper_collision" friction="3.0 0.5 0.01" solref="0.01 1"/>
        <pair geom1="knob_axis" geom2="RB1_finger_lower_collision" friction="3.0 0.5 0.01" solref="0.01 1"/>
    </contact>

    <!-- 월드 바디 -->
    <worldbody>
        <!-- 조명 -->
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

        <!-- 바닥 -->
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
        <!-- 장애물 -->
        <geom pos="1.2 0 0.04" type="box" size="0.1 2 0.04"/>
        <geom pos="1.6 0 0.04" type="box" size="0.1 2 0.04"/>
        <geom pos="2.3 0 0.02" type="box" size="0.2 2 0.15"/>
        <geom pos="2.6 0 0.02" type="box" size="0.22 2 0.3"/>
        <geom pos="2.8 0 0.02" type="box" size="0.23 2 0.45"/>
        <geom pos="3.0 0 0.02" type="box" size="0.24 2 0.6"/>
        <geom pos="3.2 0 0.02" type="box" size="0.25 2 0.75"/>
        <geom pos="3.4 0 0.02" type="box" size="0.26 2 0.9"/>

        <!-- 문/프레임/손잡이 통합 구조체 (위치 조정하여 충돌 방지) -->
        <body name="door_wall_link" pos="+2.6 -5.8 0.0" euler="0 0 -3.14" childclass="wall">
            <inertial mass="100" pos="0 0 0" diaginertia="0.001 0.001 0.001"/>
            <geom material="Paint" name="wall_0" pos="0 -1.5335 1.168" size="0.15 1.0 1.168" type="box"/>
            <geom material="Paint" name="wall_1" pos="0 1.5635 1.168" size="0.15 1.0 1.168" type="box"/>
            <geom material="Paint" name="wall_2" pos="0 0 2.836" size="0.15 2.5635 0.5" type="box"/>
            <!-- Valve texture removed - using material color instead -->

            <body name="frame_link" pos="0 -0.30591 1.0" childclass="frame">
                <inertial mass="500" pos="0 0 0" diaginertia="0.001 0.001 0.001"/>
                <geom material="Metal" name="doorstopper" pos="-0.0154 -0.00759 1.186" size="0.011 0.05 0.025" type="box"/>
                <geom material="Paint" name="door_frame_0" pos="0 -0.21759 0.168" size="0.011 0.05 1.168" type="box"/>
                <geom material="Paint" name="door_frame_1" pos="0 0.82941 0.168" size="0.011 0.05 1.168" type="box"/>
                <geom material="Paint" name="door_frame_2" pos="0 0.30591 1.286" size="0.011 0.5635 0.05" type="box"/>
                <geom material="Paint" name="door_frame_3" pos="-0.04825 -0.21759 0.168" size="0.011 0.05 1.168" type="box"/>
                <geom material="Paint" name="door_frame_4" pos="-0.04825 0.82941 0.168" size="0.011 0.05 1.168" type="box"/>
                <geom material="Paint" name="door_frame_5" pos="-0.04825 0.30591 1.286" size="0.011 0.5635 0.05" type="box"/>

                <body name="door_link" pos="0.0242 0 0" childclass="door">
                    <joint armature="0.0001" axis="0 0 1" damping="1.0" name="hinge0" pos="0 0.76941 0" range="-0.5 1.5" limited="true" type="hinge"/>
                    <geom material="Wood" name="door0" pos="0 0.30591 0.118" size="0.011 0.4635 1.10682" type="box"/>
                    <inertial mass="12.08" pos="0 0.30591 0.118" diaginertia="5.9 5.03 4.0"/>

                    <!-- Aruco marker: fixed to door (not moving with lever) -->
                    <body name="marker_link" pos="0 -0.01 0">
                        <inertial mass="0.01" pos="0 0 0" diaginertia="0.0001 0.0001 0.0001"/>
                        <geom name="aruco_marker" type="box" size="0.08 0.08 0.01" pos="0.1 0.1 -0.5" rgba="1 1 1 1" material="aruco_material" euler="0 1.57 0"/>
                    </body>
                    
                    <body name="knob_link" pos="0 -0.01 0" childclass="door_knob">
                        <inertial mass="1" pos="0 0 0" diaginertia="0.001 0.001 0.001"/>
                        <!-- Lever joint: allows lever to rotate (press down motion) -->
                        <!-- Range: -60 degrees to +60 degrees (approximately -1.047 to 1.047 radians) -->
                        <!-- Axis: 1 0 0 (X-axis rotation for lever press down motion) -->
                        <joint name="lever_joint" type="hinge" axis="1 0 0" pos="0 0 0" damping="0.1" armature="0.001" range="-1.047 1.047" limited="true"/>
                        
                        <body name="roundknob_link" pos="-0.05 0 0" childclass="door_knob">
                            <geom name="knob_1" mesh="door_knob_1" euler="-1.57 1.57 0" contype="0" conaffinity="0"/>
                            <geom name="knob_2" mesh="door_knob_2" euler="-1.57 1.57 0" contype="0" conaffinity="0"/>
                            <geom name="knob_3" mesh="door_knob_3" euler="-1.57 1.57 0" contype="0" conaffinity="0"/>
                            <geom name="knob_4" mesh="door_knob_4" euler="-1.57 1.57 0" contype="0" conaffinity="0"/>
                            <geom name="knob_5" mesh="door_knob_5" euler="-1.57 1.57 0" contype="0" conaffinity="0"/>
                            <geom name="knob_axis" type="box" size="0.01 0.015 0.005" euler="0 1.57 0" pos="0 0 0" rgba="1 1 0 1" contype="1" conaffinity="1"/>
                            <geom name="knob_bar" type="box" size="0.01 0.015 0.105" euler="1.57 0 0" pos="0.12 0.075 0" rgba="0.7 0.7 0.7 1" contype="1" conaffinity="1"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>
    
    <!-- Actuators -->
    <actuator>
        <!-- Lever actuator: soft position control to return to center (reference position = 0) -->
        <!-- Lower gains for easier manipulation by robot arm -->
        <position name="lever_actuator" joint="lever_joint" kp="3" kv="0" ctrllimited="true" ctrlrange="-1.047 1.047"/>
    </actuator>
</mujoco>

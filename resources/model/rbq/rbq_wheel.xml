                 identical between the two variants, so the mounts do not move.
                 site = sensor frame (raytrace origin); geom = housing mesh (visual only).
                 Group 4 = Livox, 5 = Ouster — hidden unless the matching flag is passed. -->
            <site name="lidar_front" pos="0.372824 0 0.127636" quat="0.953716987 0 0.300705686 0"/>
            <geom type="mesh" mesh="mid360_body" material="mid360_body_mat" class="visual" group="4"

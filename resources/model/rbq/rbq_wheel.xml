            <geom type="mesh" mesh="ouster_window" material="ouster_window_mat" class="visual" group="5"
                  pos="-0.3125 0 0.105" quat="0 0 0 1"/>

            <body name="BT0_body" pos="0.364 0 -0.024919" quat="0 -0.1736482 0 0.9848078">
